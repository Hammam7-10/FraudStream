FROM itversity/itvdelab:latest
USER root
RUN tar xzf /softwares/hadoop-3.3.0.tar.gz -C /opt \
    && mv /opt/hadoop-3.3.0 /opt/hadoop \
    && tar xzf /softwares/spark-3.1.2-bin-hadoop3.2.tgz -C /opt \
    && mv /opt/spark-3.1.2-bin-hadoop3.2 /opt/spark
ENV JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk-amd64 \
    HADOOP_HOME=/opt/hadoop \
    SPARK_HOME=/opt/spark \
    PYSPARK_PYTHON=/usr/bin/python3 \
    PATH=/opt/spark/bin:/opt/hadoop/bin:$PATH
RUN pip3 install --no-cache-dir numpy==1.19.5 kafka-python==2.0.2 \
    fastapi==0.83.0 uvicorn==0.16.0
COPY docker/spark-jars/ /opt/spark/jars/
WORKDIR /app
USER itversity
